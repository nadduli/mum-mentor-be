[Unit]
Description=Mum Mentor API - FastAPI Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mum-mentor-be
Environment="PATH=/var/www/mum-mentor-be/venv/bin"
EnvironmentFile=/var/www/mum-mentor-be/.env
ExecStart=/var/www/mum-mentor-be/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/mum-mentor-be

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mum-mentor-api

[Install]
WantedBy=multi-user.target
